<Window x:Class="VideoCompressor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compressore Video (GPU NVENC)" Height="700" Width="980" MinHeight="600" MinWidth="860"
        Icon="app.ico" Background="{DynamicResource WindowBackgroundBrush}"
        AllowDrop="True" DragEnter="Window_DragEnter" DragOver="Window_DragEnter"
        DragLeave="Window_DragLeave" Drop="Window_Drop">
    <Window.Resources>
        <DataTemplate x:Key="OptionItemTemplate">
            <TextBlock Text="{Binding Label}"/>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="File">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Cartella destinazione:" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="DestTextBox" Grid.Column="1" VerticalAlignment="Center" Margin="6,0" Padding="4"/>
                        <Button x:Name="BrowseDestButton" Content="Sfoglia..." Grid.Column="2" Click="BrowseDest_Click" Padding="10,5"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Codec:" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CodecCombo" Grid.Column="1" Width="270" Margin="4,0,20,0" ItemTemplate="{StaticResource OptionItemTemplate}" SelectionChanged="CodecOrLevel_SelectionChanged"/>
                        <Label Content="Livello compressione:" Grid.Column="2" VerticalAlignment="Center"/>
                        <ComboBox x:Name="LevelCombo" Grid.Column="3" Width="300" Margin="4,0" ItemTemplate="{StaticResource OptionItemTemplate}" SelectionChanged="CodecOrLevel_SelectionChanged"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="AddFilesButton" Content="Aggiungi file..." Click="AddFiles_Click" Padding="10,5" Margin="0,0,6,0"/>
                        <Button x:Name="AddFolderButton" Content="Aggiungi cartella..." Click="AddFolder_Click" Padding="10,5" Margin="0,0,6,0"/>
                        <Button x:Name="RemoveSelectedButton" Content="Rimuovi selezionati" Click="RemoveSelected_Click" Padding="10,5" Margin="0,0,6,0"/>
                        <Button x:Name="ClearListButton" Content="Svuota lista" Click="ClearList_Click" Padding="10,5"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="Suggerimento: puoi anche trascinare qui file o cartelle da comprimere."
                               FontSize="11" Foreground="{DynamicResource SubForegroundBrush}" Margin="0,0,0,6"/>

                    <DataGrid x:Name="FilesGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" CanUserAddRows="False" RowHeaderWidth="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" Cursor="Arrow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="170"/>
                            <DataGridTextColumn Header="Dimensione originale" Binding="{Binding OriginalSizeText}" Width="120"/>
                            <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding ErrorDetail}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Avanzamento" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Height="16"/>
                                            <TextBlock Text="{Binding ProgressText}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Stima output" Binding="{Binding EstimatedSizeText}" Width="110"/>
                            <DataGridTextColumn Header="Dimensione finale" Binding="{Binding ResultSizeText}" Width="110"/>
                            <DataGridTemplateColumn Header="Azioni" Width="*" MinWidth="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Originale" Padding="5,2" Margin="0,0,3,0" Click="OpenSource_Click"/>
                                            <Button Content="Risultato" Padding="5,2" Margin="0,0,3,0" Click="OpenResult_Click" IsEnabled="{Binding HasResult}"/>
                                            <Button Content="Log" Padding="5,2" Click="ShowLog_Click" IsEnabled="{Binding HasErrorLog}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Impostazioni">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,10">
                    <StackPanel Margin="0,0,0,14">
                        <CheckBox x:Name="PreserveStructureCheck" Content="Mantieni struttura cartelle (per elementi aggiunti da cartella)" IsChecked="True" Margin="0,3"/>
                        <CheckBox x:Name="SkipExistingCheck" Content="Salta se il file di destinazione esiste gia" IsChecked="True" Margin="0,3"/>
                        <CheckBox x:Name="DeleteSourceCheck" Content="Elimina l'originale dopo compressione riuscita (irreversibile)" Margin="0,3"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Tema:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource SubForegroundBrush}"/>
                        <ComboBox x:Name="ThemeModeCombo" Width="90" Margin="0,0,14,0" SelectionChanged="ThemeCombo_SelectionChanged" ItemTemplate="{StaticResource OptionItemTemplate}"/>
                        <TextBlock Text="Colore:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource SubForegroundBrush}"/>
                        <ComboBox x:Name="AccentColorCombo" Width="100" SelectionChanged="ThemeCombo_SelectionChanged" ItemTemplate="{StaticResource OptionItemTemplate}"/>
                    </StackPanel>

                    <TextBlock Text="Accesso da remoto (rete locale)" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="Permette di caricare e scaricare video da un browser su un altro PC della stessa rete."
                               FontSize="11" Foreground="{DynamicResource SubForegroundBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <CheckBox x:Name="WebUiEnabledCheck" Content="Abilita interfaccia web" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Porta:" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="WebUiPortTextBox" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,20,0" Padding="4"/>
                        <Label Content="Utente:" Grid.Column="2" VerticalAlignment="Center"/>
                        <TextBox x:Name="WebUiUsernameTextBox" Grid.Column="3" VerticalAlignment="Center" Margin="4,0,20,0" Padding="4"/>
                        <Label Content="Password:" Grid.Column="4" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="WebUiPasswordBox" Grid.Column="5" VerticalAlignment="Center" Margin="4,0" Padding="4"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Applica" Click="WebUiApply_Click" Padding="10,5"/>
                    </StackPanel>

                    <TextBlock x:Name="WebUiStatusLabel" Text="Interfaccia web non attiva." TextWrapping="Wrap"
                               Foreground="{DynamicResource SubForegroundBrush}"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar x:Name="OverallProgress" Grid.Row="0" Height="20" Minimum="0"/>
            <Grid Grid.Row="1" Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLabel" Grid.Column="0" Text="Pronto."/>
                <TextBlock x:Name="EtaLabel" Grid.Column="1" Text="" Foreground="{DynamicResource SubForegroundBrush}"/>
            </Grid>
            <TextBlock x:Name="EstimateSummaryLabel" Grid.Row="2" Text="" Margin="0,0,0,5" Foreground="{DynamicResource SubForegroundBrush}"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <Button x:Name="EstimateButton" Content="Stima compressione" Click="Estimate_Click" Padding="12,7" Margin="0,0,6,0"/>
                <Button x:Name="StartButton" Content="Avvia compressione" Click="Start_Click" Padding="12,7" Margin="0,0,6,0" Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Name="CancelButton" Content="Annulla" Click="Cancel_Click" Padding="12,7" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False"
                Background="#CC000000" CornerRadius="8">
            <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3" CornerRadius="10" Margin="24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#8681;" FontSize="42" HorizontalAlignment="Center" Foreground="White"/>
                    <TextBlock Text="Rilascia qui i file o le cartelle da comprimere" FontSize="16" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
