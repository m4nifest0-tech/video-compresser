<Window x:Class="VideoCompressor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compressore Video (GPU NVENC)" Height="680" Width="920" MinHeight="580" MinWidth="800"
        Icon="app.ico" Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <DataTemplate x:Key="OptionItemTemplate">
            <TextBlock Text="{Binding Label}"/>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Button Content="Aggiungi file..." Click="AddFiles_Click" Padding="10,5" Margin="0,0,6,0"/>
                <Button Content="Aggiungi cartella..." Click="AddFolder_Click" Padding="10,5" Margin="0,0,6,0"/>
                <Button Content="Rimuovi selezionati" Click="RemoveSelected_Click" Padding="10,5" Margin="0,0,6,0"/>
                <Button Content="Svuota lista" Click="ClearList_Click" Padding="10,5"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Tema:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource SubForegroundBrush}"/>
                <ComboBox x:Name="ThemeModeCombo" Width="90" Margin="0,0,14,0" SelectionChanged="ThemeCombo_SelectionChanged" ItemTemplate="{StaticResource OptionItemTemplate}"/>
                <TextBlock Text="Colore:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource SubForegroundBrush}"/>
                <ComboBox x:Name="AccentColorCombo" Width="100" SelectionChanged="ThemeCombo_SelectionChanged" ItemTemplate="{StaticResource OptionItemTemplate}"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="FilesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" CanUserAddRows="False" Margin="0,0,0,8" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="260"/>
                <DataGridTextColumn Header="Dimensione originale" Binding="{Binding OriginalSizeText}" Width="130"/>
                <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="100"/>
                <DataGridTemplateColumn Header="Avanzamento" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Height="16"/>
                                <TextBlock Text="{Binding ProgressText}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Stima output" Binding="{Binding EstimatedSizeText}" Width="130"/>
                <DataGridTextColumn Header="Dimensione finale" Binding="{Binding ResultSizeText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Content="Cartella destinazione:" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="DestTextBox" Grid.Column="1" VerticalAlignment="Center" Margin="6,0" Padding="4"/>
            <Button Content="Sfoglia..." Grid.Column="2" Click="BrowseDest_Click" Padding="10,5"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Codec:" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox x:Name="CodecCombo" Grid.Column="1" Width="270" Margin="4,0,20,0" ItemTemplate="{StaticResource OptionItemTemplate}" SelectionChanged="CodecOrLevel_SelectionChanged"/>
            <Label Content="Livello compressione:" Grid.Column="2" VerticalAlignment="Center"/>
            <ComboBox x:Name="LevelCombo" Grid.Column="3" Width="300" Margin="4,0" ItemTemplate="{StaticResource OptionItemTemplate}" SelectionChanged="CodecOrLevel_SelectionChanged"/>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <CheckBox x:Name="PreserveStructureCheck" Content="Mantieni struttura cartelle (per elementi aggiunti da cartella)" IsChecked="True" Margin="0,3"/>
            <CheckBox x:Name="SkipExistingCheck" Content="Salta se il file di destinazione esiste gia" IsChecked="True" Margin="0,3"/>
            <CheckBox x:Name="DeleteSourceCheck" Content="Elimina l'originale dopo compressione riuscita (irreversibile)" Margin="0,3"/>
        </StackPanel>

        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar x:Name="OverallProgress" Grid.Row="0" Height="20" Minimum="0"/>
            <Grid Grid.Row="1" Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLabel" Grid.Column="0" Text="Pronto."/>
                <TextBlock x:Name="EtaLabel" Grid.Column="1" Text="" Foreground="{DynamicResource SubForegroundBrush}"/>
            </Grid>
            <TextBlock x:Name="EstimateSummaryLabel" Grid.Row="2" Text="" Margin="0,0,0,5" Foreground="{DynamicResource SubForegroundBrush}"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <Button x:Name="EstimateButton" Content="Stima compressione" Click="Estimate_Click" Padding="12,7" Margin="0,0,6,0"/>
                <Button x:Name="StartButton" Content="Avvia compressione" Click="Start_Click" Padding="12,7" Margin="0,0,6,0" Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Name="CancelButton" Content="Annulla" Click="Cancel_Click" Padding="12,7" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
