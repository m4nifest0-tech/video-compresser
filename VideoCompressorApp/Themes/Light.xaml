    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F6FA"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AlternateRowBrush" Color="#F0F1F5"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#ECEDF2"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#1B1D23"/>
    <SolidColorBrush x:Key="SubForegroundBrush" Color="#5B6070"/>
